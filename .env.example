# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel, cargá las variables en Settings → Environment Variables.

# Código de acceso (opcional). Si lo completás, Infocine pide este código
# antes de entrar y no aparece en Google. Si lo dejás vacío, es público.
CODIGO_ACCESO=

# Dirección pública del sitio (opcional). En Vercel se completa sola.
# Ejemplo: https://infocine.vercel.app
NEXT_PUBLIC_SITIO_URL=
