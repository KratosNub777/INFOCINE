# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel, cargá las variables en Settings → Environment Variables.

# Código de acceso (opcional). Si lo completás, Infocine pide este código
# antes de entrar y no aparece en Google. Si lo dejás vacío, es público.
CODIGO_ACCESO=

# Dirección pública del sitio (opcional). En Vercel se completa sola.
# Ejemplo: https://infocine.vercel.app
NEXT_PUBLIC_SITIO_URL=

# ── Fase 2 (opcional): panel de profesores, cuentas, vistas y “me gusta” ──
# Supabase → Project Settings → API Keys. Si quedan vacías, se usa data/cortos.ts.
# Las cuentas de espectadores (correo y Google) no necesitan variables nuevas: se
# configuran en el panel de Supabase (docs/fase-2/README.md → Cuentas de espectadores).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA: solo en .env.local de tu compu, para los scripts
# (npm run agregar-editor / migrar-a-supabase). Nunca en Vercel ni en GitHub.
SUPABASE_SECRET_KEY=
